{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev",
      "type": "npm",
      "script": "dev",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE .* ready in",
          "endsPattern": "^.*$"
        }
      }
    },
    {
      "label": "build",
      "type": "npm",
      "script": "build",
      "group": {
        "kind": "build"
      }
    },
    {
      "label": "lint",
      "type": "npm",
      "script": "lint",
      "group": {
        "kind": "test"
      }
    },
    {
      "label": "format",
      "type": "npm",
      "script": "format",
      "group": {
        "kind": "test"
      }
    }
  ]
}
